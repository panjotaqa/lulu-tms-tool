meta {
  name: Tentar criar bug com projeto inexistente
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/bugs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Bug inválido",
    "projectId": "00000000-0000-0000-0000-000000000000"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("deve retornar projeto não encontrado", () => {
    expect(res.getStatus()).to.equal(404);
  });
}
